{
  "name": "tricktionary-be",
  "version": "1.0.1",
  "description": "",
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "sh ./scripts/makeElastic.sh",
    "start": "node ./dist/src/index.js --unhandled-rejections=strict",
    "pre-docs": "rm -rf trex/docs/tricktionary",
    "post-docs": "./scripts/copyMarkdown.sh && ./scripts/buildDocs.sh",
    "gen-docs": "npx typedoc --plugin typedoc-plugin-markdown --modulesFileName modules src/sockets",
    "docs": "npm run pre-docs && npm run gen-docs && npm run post-docs",
    "develop": "npm run build && npm run docs && npm start",
    "test": "npm run build && node --test \"dist/src/sockets/__tests__/*.test.js\""
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/story-squad/tricktionary-be.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/story-squad/tricktionary-be/issues"
  },
  "homepage": "https://github.com/story-squad/tricktionary-be#readme",
  "dependencies": {
    "@okta/jwt-verifier": "^4.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.20.0",
    "body-parser": "^1.20.4",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.22.3",
    "helmet": "^4.3.1",
    "http-errors": "^1.8.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "knex-cleaner": "^1.3.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "randomatic": "^3.1.1",
    "redis": "^3.1.1",
    "socket.io": "^4.8.4",
    "socket.io-redis": "^6.0.1",
    "stripe": "^8.138.0",
    "tslint": "^6.1.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/helmet": "^4.0.0",
    "@types/http-errors": "^1.8.0",
    "@types/node": "^24.19.2",
    "@types/randomatic": "^3.1.3",
    "@types/redis": "^2.8.28",
    "@types/socket.io-redis": "^1.0.27",
    "docusaurus-plugin-typedoc": "^1.4.3",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "njwt": {
      "uuid": "^11.1.1"
    }
  }
}
